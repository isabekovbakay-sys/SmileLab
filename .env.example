# Источник данных: mock (по умолчанию, данные внутри приложения) или api (свой сервер).
EXPO_PUBLIC_DATA_SOURCE=mock
# Адрес сервера, если EXPO_PUBLIC_DATA_SOURCE=api. Без завершающего «/».
EXPO_PUBLIC_API_BASE_URL=
# 1 — демо-сборка (примерные услуги, врачи, часы, плашка «Демо»). Для релиза — 0 или пусто.
# В EAS задаётся профилем в eas.json ("demo" — 1, "apk" и "production" — 0).
# После смены значения запускайте Metro с очисткой кэша: npx expo start --clear
EXPO_PUBLIC_DEMO=0
