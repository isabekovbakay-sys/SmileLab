{
  "name": "smilelab",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "build:apk": "bash scripts/build-apk.sh apk",
    "build:aab": "bash scripts/build-apk.sh production",
    "build:apk:demo": "bash scripts/build-apk.sh demo",
    "privacy:html": "tsx scripts/privacy-page.ts",
    "release:check": "tsx scripts/release-check.ts",
    "bundle:check": "tsx scripts/bundle-check.ts",
    "ky:review": "tsx scripts/ky-review.ts",
    "icons": "node scripts/generate-icons.mjs",
    "store:graphics": "node scripts/store-screenshots.mjs",
    "build:apk:debug-local": "echo \"ВНИМАНИЕ: локальная сборка подписана ОТЛАДОЧНЫМ ключом — только для проверки на своём телефоне. Пациентам и в Google Play — только сборки EAS (npm run build:apk / build:aab).\" && expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "eas-build-post-install": "tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "playwright-core": "1.56.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@expo/ui"
        ]
      }
    }
  }
}
